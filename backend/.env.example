NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scarfaceev?schema=public
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
LOG_LEVEL=info

# OAuth credentials are backend-only. BACKEND_URL must be the public API origin
# that the browser uses (through a same-origin /api proxy or VITE_API_BASE_URL).
# Register each callback as ${BACKEND_URL}/api/auth/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=consumers
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Configure Resend credentials to deliver enquiry emails to this address.
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
COMPANY_NOTIFICATION_EMAIL=hasith@scarfaceev.com
SEND_CUSTOMER_ACK=false
EMAIL_POLL_INTERVAL_MS=5000
EMAIL_MAX_RETRIES=5

# local is suitable only for development. Use s3 with private storage in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

MAX_JSON_BODY=256kb
MAX_RESUME_SIZE_BYTES=5242880
MAX_MEDIA_SIZE_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
