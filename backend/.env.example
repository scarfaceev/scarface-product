NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scarfaceev?schema=public
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
LOG_LEVEL=info

# Email is deliberately disabled until a provider and recipient are configured.
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
COMPANY_NOTIFICATION_EMAIL=
SEND_CUSTOMER_ACK=false
EMAIL_POLL_INTERVAL_MS=5000
EMAIL_MAX_RETRIES=5

# local is suitable only for development. Use s3 with private storage in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
DATABASE_URL=

MAX_JSON_BODY=256kb
MAX_RESUME_SIZE_BYTES=5242880
MAX_MEDIA_SIZE_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
