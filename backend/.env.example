NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scarfaceev?schema=public
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
# Required in production; Vercel sends this as the cron Authorization bearer token.
CRON_SECRET=
SESSION_TTL_DAYS=7
LOG_LEVEL=info

# OAuth credentials are backend-only. BACKEND_URL must be the public API origin
# that the browser uses (through a same-origin /api proxy or VITE_API_BASE_URL).
# Register each callback as ${BACKEND_URL}/api/auth/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=


# Set provider credentials and the company recipient only in the backend environment.
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
ENQUIRY_RECEIVER_EMAIL=
COMPANY_NOTIFICATION_EMAIL=
SEND_CUSTOMER_ACK=false
EMAIL_POLL_INTERVAL_MS=5000
EMAIL_MAX_RETRIES=5

MAX_JSON_BODY=256kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
