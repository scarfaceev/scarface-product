generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
  SPAM
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InstallationType {
  HOME
  COMMERCIAL
}

enum PropertyType {
  HOUSE
  APARTMENT
  COMMERCIAL
  INDUSTRIAL
  OTHER
}

enum InstallationStatus {
  NEW
  CONTACTED
  ASSESSMENT_PENDING
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaKind {
  IMAGE
  DOCUMENT
  RESUME
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationType {
  ENQUIRY_ADMIN
  ENQUIRY_ACK
  INSTALLATION_ADMIN
  JOB_APPLICATION_ADMIN
  JOB_APPLICATION_ACK
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
  APPLE
  GITHUB
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  fullName        String               @db.VarChar(120)
  email           String?              @unique @db.VarChar(254)
  emailVerifiedAt DateTime?            @db.Timestamptz(3)
  phone           String?              @db.VarChar(32)
  passwordHash    String?              @db.VarChar(255)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  oauthIdentities OAuthIdentity[]
  sessions        AuthSession[]
  passwordResets  PasswordResetToken[]

  @@index([createdAt])
}

model OAuthIdentity {
  id                    String       @id @default(uuid()) @db.Uuid
  userId                String       @db.Uuid
  provider              AuthProvider
  providerAccountId     String       @db.VarChar(255)
  providerEmail         String?      @db.VarChar(254)
  providerEmailVerified Boolean      @default(false)
  providerName          String?      @db.VarChar(120)
  avatarUrl             String?      @db.VarChar(2048)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Enquiry {
  id        String        @id @default(uuid()) @db.Uuid
  fullName  String        @db.VarChar(120)
  email     String        @db.VarChar(254)
  phone     String?       @db.VarChar(32)
  interest  String        @db.VarChar(40)
  message   String        @db.Text
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  resolvedAt DateTime?    @db.Timestamptz(3)
  notifications NotificationOutbox[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique @db.VarChar(160)
  name             String        @db.VarChar(200)
  description      String        @db.Text
  category         String        @db.VarChar(100)
  features         Json          @default("[]")
  specifications   Json          @default("{}")
  status           ProductStatus @default(DRAFT)
  datasheetMediaId String?       @db.Uuid
  datasheetMedia   MediaAsset?   @relation("ProductDatasheet", fields: [datasheetMediaId], references: [id], onDelete: SetNull)
  media            ProductMedia[]
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  publishedAt      DateTime?     @db.Timestamptz(3)

  @@index([status, category])
  @@index([publishedAt])
}

model ProductMedia {
  productId   String     @db.Uuid
  mediaAssetId String    @db.Uuid
  position    Int        @default(0)
  altText     String?    @db.VarChar(300)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([productId, mediaAssetId])
  @@unique([productId, position])
  @@index([mediaAssetId])
}

model InstallationRequest {
  id                     String             @id @default(uuid()) @db.Uuid
  fullName               String             @db.VarChar(120)
  email                  String             @db.VarChar(254)
  phone                  String             @db.VarChar(32)
  installationType       InstallationType
  propertyType           PropertyType
  addressLine1           String             @db.VarChar(200)
  addressLine2           String?            @db.VarChar(200)
  city                   String             @db.VarChar(120)
  region                 String             @db.VarChar(120)
  postalCode             String             @db.VarChar(24)
  country                String             @db.VarChar(100)
  additionalRequirements String?            @db.Text
  status                 InstallationStatus @default(NEW)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)
  notifications          NotificationOutbox[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}

model Job {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique @db.VarChar(160)
  title          String         @db.VarChar(200)
  department     String         @db.VarChar(120)
  description    String         @db.Text
  employmentType EmploymentType
  location       String         @db.VarChar(200)
  status         JobStatus      @default(DRAFT)
  applications   JobApplication[]
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  publishedAt    DateTime?      @db.Timestamptz(3)

  @@index([status, publishedAt])
}

model JobApplication {
  id            String            @id @default(uuid()) @db.Uuid
  jobId         String            @db.Uuid
  applicantName String            @db.VarChar(120)
  email         String            @db.VarChar(254)
  phone         String            @db.VarChar(32)
  resumeMediaId String            @db.Uuid
  coverLetter   String?           @db.Text
  status        ApplicationStatus @default(RECEIVED)
  submittedAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resume        MediaAsset        @relation(fields: [resumeMediaId], references: [id], onDelete: Restrict)
  notifications NotificationOutbox[]

  @@index([jobId, submittedAt])
  @@index([status, submittedAt])
}

model ContentPage {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique @db.VarChar(160)
  title          String         @db.VarChar(200)
  seoTitle       String?        @db.VarChar(200)
  seoDescription String?        @db.VarChar(320)
  status         ContentStatus  @default(DRAFT)
  sections       ContentSection[]
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  publishedAt    DateTime?      @db.Timestamptz(3)

  @@index([status, publishedAt])
}

model ContentSection {
  id        String      @id @default(uuid()) @db.Uuid
  pageId    String      @db.Uuid
  key       String      @db.VarChar(100)
  kind      String      @db.VarChar(80)
  content   Json
  sortOrder Int         @default(0)
  page      ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

model MediaAsset {
  id            String          @id @default(uuid()) @db.Uuid
  storageKey    String          @unique @db.VarChar(500)
  originalName  String          @db.VarChar(255)
  mimeType      String          @db.VarChar(120)
  sizeBytes     Int
  sha256        String?         @db.VarChar(64)
  kind          MediaKind
  visibility    MediaVisibility @default(PRIVATE)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  productMedia  ProductMedia[]
  productSheets Product[]       @relation("ProductDatasheet")
  applications  JobApplication[]

  @@index([visibility, kind])
}

model NotificationOutbox {
  id                    String             @id @default(uuid()) @db.Uuid
  dedupeKey             String             @unique @db.VarChar(240)
  type                  NotificationType
  recipient             String             @db.VarChar(254)
  status                NotificationStatus @default(PENDING)
  retryCount            Int                @default(0)
  nextRetryAt           DateTime           @default(now()) @db.Timestamptz(3)
  lockedAt              DateTime?          @db.Timestamptz(3)
  providerReference     String?            @db.VarChar(240)
  lastError             String?            @db.VarChar(500)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  sentAt                DateTime?          @db.Timestamptz(3)
  enquiryId             String?            @db.Uuid
  installationRequestId String?            @db.Uuid
  jobApplicationId      String?            @db.Uuid
  enquiry               Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  installationRequest  InstallationRequest? @relation(fields: [installationRequestId], references: [id], onDelete: Cascade)
  jobApplication        JobApplication?    @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([createdAt])
}
